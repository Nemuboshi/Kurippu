<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kurippu.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F5F6"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="RaisedBrush" Color="#F0F1F2"/>
                    <SolidColorBrush x:Key="InkBrush" Color="#202327"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#6C727A"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#E0E3E6"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#087F70"/>
                    <Color x:Key="SystemAccentColor">#087F70</Color>
                    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#AA4537"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#1E2023"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#292C30"/>
                    <SolidColorBrush x:Key="RaisedBrush" Color="#35393E"/>
                    <SolidColorBrush x:Key="InkBrush" Color="#F2F3F4"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#AFB5BC"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#444A50"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#62C7AE"/>
                    <Color x:Key="SystemAccentColor">#62C7AE</Color>
                    <SolidColorBrush x:Key="AccentInkBrush" Color="#102720"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F3A092"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#087F70"/>
                <ColorPaletteResources x:Key="Dark" Accent="#62C7AE"/>
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
