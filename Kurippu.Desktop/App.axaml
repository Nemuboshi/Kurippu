<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Kurippu.Desktop.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#F3F1E9"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEF9"/>
                    <SolidColorBrush x:Key="RaisedBrush" Color="#EAEDE5"/>
                    <SolidColorBrush x:Key="InkBrush" Color="#22332E"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#64736B"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#D8DFD6"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#087F70"/>
                    <Color x:Key="SystemAccentColor">#087F70</Color>
                    <SolidColorBrush x:Key="AccentInkBrush" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#AA4537"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CanvasBrush" Color="#181F1D"/>
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#242E2B"/>
                    <SolidColorBrush x:Key="RaisedBrush" Color="#34413C"/>
                    <SolidColorBrush x:Key="InkBrush" Color="#F0F2E9"/>
                    <SolidColorBrush x:Key="MutedBrush" Color="#A7B9AE"/>
                    <SolidColorBrush x:Key="LineBrush" Color="#46554E"/>
                    <SolidColorBrush x:Key="AccentBrush" Color="#62C7AE"/>
                    <Color x:Key="SystemAccentColor">#62C7AE</Color>
                    <SolidColorBrush x:Key="AccentInkBrush" Color="#102720"/>
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F3A092"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#087F70"/>
                <ColorPaletteResources x:Key="Dark" Accent="#62C7AE"/>
            </FluentTheme.Palettes>
        </FluentTheme>
    </Application.Styles>
</Application>
