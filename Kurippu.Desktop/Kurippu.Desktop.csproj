<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PackageOutputDirectory Condition="'$(PackageOutputDirectory)' == ''">$(MSBuildProjectDirectory)/../publish/$(RuntimeIdentifier)</PackageOutputDirectory>
    <PackagingProject>$(MSBuildProjectDirectory)/../Kurippu.Packaging/Kurippu.Packaging.csproj</PackagingProject>
    <PackagingTool>$(MSBuildProjectDirectory)/../Kurippu.Packaging/bin/$(Configuration)/net10.0/Kurippu.Packaging.dll</PackagingTool>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kurippu.Core\Kurippu.Core.csproj" />
  </ItemGroup>

  <Target Name="ValidatePackageRuntimeIdentifier">
    <Error Condition="'$(RuntimeIdentifier)' == ''"
           Text="Package requires -r/--runtime. Supported RIDs: win-x64;osx-x64;osx-arm64;linux-x64." />
  </Target>

  <Target Name="Package" DependsOnTargets="ValidatePackageRuntimeIdentifier;Restore;Build">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishDir=$(PackageOutputDirectory)" />
    <MSBuild Projects="$(PackagingProject)"
             Targets="Restore;Build"
             RemoveProperties="RuntimeIdentifier;SelfContained;PublishDir;PackageOutputDirectory"
             Properties="Configuration=$(Configuration)" />
    <Exec Command="dotnet &quot;$(PackagingTool)&quot; stage &quot;$(RuntimeIdentifier)&quot; &quot;$(PackageOutputDirectory)&quot;" />
  </Target>
</Project>
