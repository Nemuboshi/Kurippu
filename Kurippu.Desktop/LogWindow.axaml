<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kurippu.Desktop.ViewModels"
        x:Class="Kurippu.Desktop.LogWindow"
        x:DataType="vm:ActivityLog"
        Title="Detail log" Width="800" Height="520" MinWidth="560" MinHeight="360"
        Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource InkBrush}">
  <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="10">
    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
      <TextBlock Text="Detail log" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Grid.Column="1" Content="Copy" Click="OnCopy"/>
      <Button Grid.Column="2" Content="Select all" Click="OnSelectAll"/>
      <Button Grid.Column="3" Content="Clear" Click="OnClear"/>
    </Grid>
    <TextBox x:Name="LogText" Grid.Row="1" Text="{Binding Text, Mode=OneWay}"
             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             FontFamily="Cascadia Code,Consolas" Background="{DynamicResource SurfaceBrush}"
             Foreground="{DynamicResource InkBrush}" BorderBrush="{DynamicResource LineBrush}"/>
  </Grid>
</Window>
