+Napi::Value node_to_js(Napi::Env env, const mpv_node& node) {
+  switch (node.format) {
+    case MPV_FORMAT_STRING:
+    case MPV_FORMAT_OSD_STRING:
+      return Napi::String::New(env, node.u.string ? node.u.string : "");
+    case MPV_FORMAT_FLAG:
+      return Napi::Boolean::New(env, node.u.flag != 0);
+    case MPV_FORMAT_INT64:
+      return Napi::Number::New(env, static_cast<double>(node.u.int64));
+    case MPV_FORMAT_DOUBLE:
+      return Napi::Number::New(env, node.u.double_);
+    case MPV_FORMAT_NODE_ARRAY: {
+      Napi::Array value = Napi::Array::New(env, node.u.list ? node.u.list->num : 0);
+      if (node.u.list) {
+        for (int i = 0; i < node.u.list->num; ++i) value.Set(i, node_to_js(env, node.u.list->values[i]));
+      }
+      return value;
+    }
+    case MPV_FORMAT_NODE_MAP: {
+      Napi::Object value = Napi::Object::New(env);
+      if (node.u.list) {
+        for (int i = 0; i < node.u.list->num; ++i) {
+          value.Set(node.u.list->keys[i], node_to_js(env, node.u.list->values[i]));
+        }
+      }
+      return value;
+    }
+    default:
+      return env.Null();
+  }
+}
