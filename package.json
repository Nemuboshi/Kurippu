{
  "name": "kurippu",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "check": "biome check . && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "start": "electron-vite preview",
    "fetch-binaries": "node scripts/fetch-binaries.ts",
    "libmpv:check": "node --experimental-strip-types scripts/libmpv-runtime.ts check",
    "libmpv:stage": "node --experimental-strip-types scripts/libmpv-runtime.ts stage",
    "libmpv:importlib": "node --experimental-strip-types scripts/libmpv-importlib.ts",
    "build:native": "node-gyp rebuild --dir=native/mpv && pnpm libmpv:stage",
    "runtime:check": "node --experimental-strip-types scripts/check-runtime.ts",
    "package": "pnpm build && pnpm runtime:check && electron-builder"
  },
  "packageManager": "pnpm@12.4.2",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.5",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^44.4.2",
    "electron-builder": "25.1.8",
    "electron-vite": "^5.0.0",
    "extract-zip": "2.0.1",
    "husky": "^9.1.7",
    "node-addon-api": "^8.9.2",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "pnpm": {},
  "main": "out/main/index.js",
  "build": {
    "appId": "works.earendil.kurippu",
    "productName": "Kurippu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/mpv/build/Release",
        "to": "native/mpv",
        "filter": [
          "mpv_addon.node",
          "*.dll",
          "*.dylib",
          "*.so*"
        ]
      },
      {
        "from": "bin/${os}-${arch}",
        "to": ".",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo"
    }
  }
}
